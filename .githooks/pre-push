#!/bin/sh
# Блокирует push, если в отправляемых коммитах есть файлы тяжелее 90 MB (лимит GitHub — 100 MB).
LIMIT=90000000
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  git rev-list --objects "$range" |
    git cat-file --batch-check='%(objecttype) %(objectsize) %(rest)' |
    awk -v limit="$LIMIT" '$1=="blob" && $2+0>limit {printf "  СЛИШКОМ БОЛЬШОЙ: %s (%d MB)\n", $3, $2/1048576; found=1} END{exit found}'
  if [ $? -ne 0 ]; then
    echo "error: push отклонён локально: в истории есть файлы больше 90 MB."
    echo "Добавьте их в .gitignore и вычистите историю (git filter-repo)."
    exit 1
  fi
done
exit 0
